PYTHONPATH=src

# MongoDB (same instance as backend)
MONGODB_USER=db_user
MONGODB_PASSWORD=db_pass
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=fiap_pos_ia_fase3

# LLM Endpoint — use ngrok URL for local Colab dev, or HuggingFace ZeroGPU for production
# Example (Colab/ngrok):   https://abcd1234.ngrok-free.app
# Example (ZeroGPU):       https://<username>-<space>.hf.space
LLM_ENDPOINT_URL=https://<ngrok-or-zerogpu-url>
LLM_API_TOKEN=hf_your_token_here

# Agent configuration
AGENT_MAX_TOKENS=512
AGENT_TEMPERATURE=0.1

# RAG configuration
RAG_EMBEDDING_MODEL=hkunlp/instructor-base
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25

# Backend API URL (for RAG queries via HTTP if not using MongoDB directly)
BACKEND_API_URL=http://fiap-pos-ia-backend:3000

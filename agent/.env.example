PYTHONPATH=src

# MongoDB (same instance as backend)
MONGODB_USER=db_user
MONGODB_PASSWORD=db_pass
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=fiap_pos_ia_fase3

# LLM Endpoint Configuration
# Provedores suportados: "auto" (auto-detectar), "hf_space" (Hugging Face Spaces) ou "fastapi" (ngrok/FastAPI)
LLM_PROVIDER=auto

# Modelo fine-tunado (público): https://huggingface.co/fiap-hospital-helper/hospital-helper-qwen2.5-1.5b
#
# Opção 1 — HF Spaces ZeroGPU (recomendado, gratuito):
#   URL do Space: https://huggingface.co/spaces/fiap-hospital-helper/hospital-helper
#   LLM_API_TOKEN não é obrigatório para Spaces públicos com ZeroGPU.
#
# Opção 2 — Colab/ngrok (desenvolvimento local):
#   Rode o notebook RuntimeModelo_01.ipynb no Colab e copie a URL do ngrok gerada.
#   LLM_API_TOKEN não é necessário para endpoints ngrok sem autenticação.
#
# Opção 3 — HuggingFace Inference API (requer conta HF com créditos):
#   LLM_ENDPOINT_URL=https://api-inference.huggingface.co/models/fiap-hospital-helper/hospital-helper-qwen2.5-1.5b
#   LLM_API_TOKEN=hf_seu_token_aqui  (obrigatório neste modo)
LLM_ENDPOINT_URL=https://<ngrok-or-zerogpu-url>
LLM_API_TOKEN=

# Agent LLM generation parameters
AGENT_MAX_TOKENS=512
AGENT_TEMPERATURE=0.3
AGENT_TOP_P=0.9

# RAG configuration
RAG_EMBEDDING_MODEL=hkunlp/instructor-base
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25

# Backend API URL (for RAG queries via HTTP)
BACKEND_API_URL=http://localhost:3000

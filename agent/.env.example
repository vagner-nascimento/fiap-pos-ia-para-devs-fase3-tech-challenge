PYTHONPATH=src

# MongoDB (same instance as backend)
MONGODB_USER=db_user
MONGODB_PASSWORD=db_pass
MONGODB_HOST=localhost
MONGODB_PORT=27017
DB_NAME=fiap_pos_ia_fase3

# LLM Endpoint Configuration
# Provedores suportados: "auto" (auto-detectar), "hf_space" (Hugging Face Spaces) ou "fastapi" (ngrok/FastAPI)
LLM_PROVIDER=auto

# Exemplo Produção (HF Spaces ZeroGPU): https://huggingface.co/spaces/fiap-hospital-helper/hospital-helper ou https://<space>.hf.space
# Exemplo Dev/Fallback (Colab/ngrok):    https://abcd1234.ngrok-free.app
LLM_ENDPOINT_URL=https://<ngrok-or-zerogpu-url>
LLM_API_TOKEN=hf_your_token_here

# Agent LLM generation parameters
AGENT_MAX_TOKENS=512
AGENT_TEMPERATURE=0.3
AGENT_TOP_P=0.9

# RAG configuration
RAG_EMBEDDING_MODEL=hkunlp/instructor-base
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25

# Backend API URL (for RAG queries via HTTP)
BACKEND_API_URL=http://localhost:3000

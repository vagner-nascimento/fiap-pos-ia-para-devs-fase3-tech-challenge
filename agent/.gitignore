# =============================================================================
# Agente Médico — .gitignore
# Baseado no .gitignore do backend do projeto
# =============================================================================

# ---------------------------------------------------------------------------
# Credenciais e configuração local — NUNCA subir
# ---------------------------------------------------------------------------
.env
.envrc
*.key
*.pem
*.cert
*.p12
secrets/
credentials/

# ---------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
# ---------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# ---------------------------------------------------------------------------
# Distribution / packaging
# ---------------------------------------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# ---------------------------------------------------------------------------
# Instaladores / logs de pacotes
# ---------------------------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------------------------------------------------------
# Ambientes virtuais
# ---------------------------------------------------------------------------
.venv
venv/
env/
ENV/
env.bak/
venv.bak/

# ---------------------------------------------------------------------------
# Gerenciadores de pacotes
# ---------------------------------------------------------------------------
# UV
# uv.lock  ← mantido em versão para reproducibilidade

# PDM
.pdm-python
.pdm-build/

# Pixi
.pixi

# PEP 582
__pypackages__/

# ---------------------------------------------------------------------------
# Testes / cobertura
# ---------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/
.tmp-tests/

# ---------------------------------------------------------------------------
# Type checkers / linters
# ---------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# ---------------------------------------------------------------------------
# Logs de runtime
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# IDEs e editores
# ---------------------------------------------------------------------------
# .idea/        ← descomente se não quiser commitar configs JetBrains
# .vscode/      ← descomente se não quiser commitar configs VS Code
.spyderproject
.spyproject
.ropeproject
tempCodeRunnerFile.py
.pypirc

# ---------------------------------------------------------------------------
# Dados e modelos — não subir arquivos grandes no git
# ---------------------------------------------------------------------------
# Cache de embeddings e modelos baixados localmente
models/
*.bin
*.safetensors
*.pt
*.ckpt

# Cache de sentence-transformers / HuggingFace
.cache/
~/.cache/huggingface/

# ---------------------------------------------------------------------------
# Outros
# ---------------------------------------------------------------------------
# Sphinx
docs/_build/

# Jupyter
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# SageMath
*.sage.py

# Celery
celerybeat-schedule
celerybeat.pid

# Redis
*.rdb
*.aof
*.pid

# mkdocs
/site

# Abstra
.abstra/

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml

# Arquivos temporários
temp.py
*.tmp
*.swp
*.swo
